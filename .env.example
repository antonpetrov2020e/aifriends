# AI Friends Bot - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===================
# REQUIRED SETTINGS
# ===================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (get from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===================
# OPTIONAL SETTINGS
# ===================

# LLM Model (default: google/gemini-2.0-flash-exp:free)
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# Alternative AI providers (optional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Environment (development/production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database
# DATABASE_URL=sqlite:///./aifriends.db
# CHROMA_DB_PATH=./chroma_db
# GENERATED_CARDS_PATH=./generated_cards

# Rate Limiting
# MAX_MESSAGES_PER_HOUR=50
# MAX_CARDS_PER_HOUR=1

# Freemium Settings
# FREE_ANALYSIS_PER_WEEK=3

# Premium & Payments (YooKassa)
# PREMIUM_PRICE_MONTHLY=990
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Proxy (for Russia/CIS if Telegram API is blocked)
# PROXY_ENABLED=False
# PROXY_URL=
